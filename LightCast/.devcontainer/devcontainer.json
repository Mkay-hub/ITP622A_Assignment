{
  "name": "LightCast PHP + MySQL Setup",

  // Use the docker-compose file below to define multiple containers (PHP + DB)
  "dockerComposeFile": "docker-compose.yml",

  // Tell Codespaces which container you'll be working in (the PHP one)
  "service": "php",

  // This is the main project folder inside the container
  "workspaceFolder": "/workspace",

  // Forward the ports so you can view your site and connect to MySQL
  "forwardPorts": [8000, 3306],

  // Run this command after everything starts — it will launch your PHP server
  "postStartCommand": ".devcontainer/start.sh",

  // Optional: automatically open the website preview when the server starts
  "portsAttributes": {
    "8000": {
      "label": "LightCast Website",
      "onAutoForward": "openPreview"
    }
  },

  // Adds helpful VS Code extensions inside Codespaces
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client", // PHP IntelliSense
        "cweijan.vscode-mysql-client2"         // MySQL Explorer
      ]
    }
  }
}
